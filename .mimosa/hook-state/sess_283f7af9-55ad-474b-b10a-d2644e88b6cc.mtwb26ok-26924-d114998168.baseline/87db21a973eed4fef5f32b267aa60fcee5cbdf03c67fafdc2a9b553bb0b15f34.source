name: Release

# 推送 v* 标签时自动构建 package.zip 并发布到 GitHub Release
on:
  push:
    tags:
      - "v*"

permissions:
  contents: write

concurrency:
  group: release-${{ github.ref }}
  cancel-in-progress: false

jobs:
  build-and-release:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # 根据 package.json 的 packageManager 字段自动安装对应版本 pnpm
      - name: Setup pnpm
        uses: pnpm/action-setup@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Verify tag version
        run: node -e "const p=require('./package.json'), m=require('./plugin.json'), tag=process.env.GITHUB_REF_NAME; if ('v'+p.version !== tag || m.version !== p.version) { console.error('Tag/package/plugin version mismatch'); process.exit(1); }"

      - name: Type check
        run: pnpm exec tsc --noEmit

      # 先构建再跑测试：兼容性矩阵等用例要求 dist/ 产物存在，
      # 顺带让包体预算与归档审计门禁校验的是本次构建的真实产物
      - name: Build package.zip
        run: pnpm build

      - name: Unit tests
        run: pnpm test

      # Archive checks run again on the clean-checkout artifact so release-only
      # size and manifest gates cannot silently skip.
      - name: Package integrity gate
        env:
          SW_REQUIRE_PACKAGE: "1"
        run: node --test tests/host/package-integrity.test.cjs tests/host/final-package-audit.test.cjs

      - name: Smoke test
        run: pnpm test:smoke

      - name: Upload to GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          files: package.zip
          generate_release_notes: true
