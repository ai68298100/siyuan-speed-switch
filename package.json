{
  "name": "siyuan-speed-switch",
  "version": "0.46.5",
  "description": "Local-first SiYuan navigation and work-context platform: switcher, workbench, snippet lab, and floating-ball actions.",
  "main": "index.js",
  "scripts": {
    "dev": "webpack --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "repro:audit": "node scripts/reproducible-build-audit.cjs",
    "test": "node tests/run-tests.cjs",
    "test:smoke": "node tests/mobile-card-smoke.cjs",
    "test:smoke:layout": "node tests/mobile-toolbar-layout.cjs",
    "test:smoke:browser": "node tests/chromium-style-smoke.cjs",
    "test:smoke:floating-ball": "node tests/floating-ball-browser-smoke.cjs",
    "verify:release": "pnpm exec tsc --noEmit && pnpm repro:audit && pnpm test && pnpm run release:check && pnpm run current-status:audit && pnpm run compatibility:probe && pnpm run desktop:acceptance && pnpm run quality:audit && pnpm run integration:audit && pnpm test:smoke && pnpm test:smoke:layout && pnpm test:smoke:browser && pnpm test:smoke:floating-ball && pnpm test:smoke:surface-switch",
    "readiness:snapshot": "node scripts/readiness-snapshot.cjs",
    "release:check": "node scripts/check-release-readiness.cjs",
    "release:audit": "node scripts/release-batch-audit.cjs",
    "quality:audit": "node scripts/quality-batch-audit.cjs",
    "current-status:audit": "node scripts/current-status-audit.cjs",
    "compatibility:probe": "node scripts/siyuan-compatibility-probe.cjs",
    "desktop:acceptance": "node scripts/desktop-acceptance-matrix.cjs",
    "integration:audit": "node scripts/integration-boundary-audit.cjs",
    "fixtures": "node scripts/serve-acceptance-fixtures.cjs 8000",
    "test:e2e": "playwright test --config playwright.e2e.config.mjs",
    "test:e2e:background": "node scripts/e2e/background-orchestrator.mjs",
    "test:e2e:readonly": "playwright test --config playwright.e2e.readonly.config.mjs",
    "test:smoke:surface-switch": "node tests/surface-switch-browser-smoke.cjs",
    "test:smoke:third-party": "node tests/third-party-lifecycle-browser-smoke.cjs",
    "shots:acceptance": "node tests/capture-acceptance-screenshots.cjs"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "navigation",
    "work-context",
    "tab-switcher",
    "siyuan-note",
    "siyuan-plugin",
    "speed-switch",
    "workbench",
    "snippet-studio",
    "quick-actions"
  ],
  "author": "ai68298100",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "ajv": "8.20.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.4.3",
    "jsdom": "^30.1.1",
    "mini-css-extract-plugin": "^2.10.2",
    "sass": "^1.105.0",
    "sass-loader": "^17.0.0",
    "siyuan": "1.2.8",
    "terser-webpack-plugin": "5.3.16",
    "tslib": "^2.8.1",
    "typescript": "^5.5.4",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.0.3",
    "zip-webpack-plugin": "^4.0.3"
  }
}
